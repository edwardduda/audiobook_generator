LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen3.6-35b-a3b
LLM_RESPONSE_FORMAT=json_schema
LLM_CONTEXT_TOKENS=100000
LLM_MAX_OUTPUT_TOKENS=90000
LLM_TIMEOUT_SECONDS=9000
LLM_TEMPERATURE=0.2
# Sent as reasoning_effort. "none" stops LM Studio's Qwen 3.x from hiding JSON in reasoning; leave empty for providers that reject it.
LLM_REASONING_EFFORT=none
# TTS engine: dramabox (expressive, MLX, 48 kHz) or chatterbox (Chatterbox Turbo, 24 kHz)
TTS_ENGINE=dramabox
TTS_SEED=0
# DramaBox settings
DRAMABOX_CFG_SCALE=2.5
DRAMABOX_STG_SCALE=1.5
DRAMABOX_STEPS=30
DRAMABOX_SPEED=1.0
# Chatterbox settings
TTS_DEVICE=auto
TTS_TEMPERATURE=0.8
# Optional: HF_TOKEN, TTS_MODEL_REVISION (Chatterbox, first download), DRAMABOX_GEMMA_DIR
# Set AUDIOBOOK_DEBUG=1 to show full tracebacks.
